# Supabase Configuration (GRATIS - Free Tier)
# Required on Vercel for real auth (Vite inlines these at build time).
# Without them the app still boots and demo login works (demo@clipflow.com / Demo123).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_aqui
# Fallback if PUBLISHABLE_KEY is not set (same value as anon key in most projects)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# OPCIONAL: OpenAI para IA generativa avanzada (sin esto, usa datos mock gratis)
# OPENAI_API_KEY=sk-...
